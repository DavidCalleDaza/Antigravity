# ============================================================
# DonApp Backend — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME="DonApp API"
ENVIRONMENT=production   # "development" | "production"
DEBUG=false
PORT=8000

# --- Security / JWT ---
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_urlsafe_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Field Encryption ---
# REQUIRED. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_Fernet_generate_key

# --- Database ---
POSTGRES_USER=servinow_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=servinow_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://servinow_user:CHANGE_ME_LOCAL_ONLY@db:5432/servinow_db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DonApp
SMTP_USE_TLS=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Social OAuth (Meta) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v21.0

# --- TikTok OAuth ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI (Gemini) ---
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GCS_VIDEO_BUCKET=
AI_VIDEO_DAILY_LIMIT=50
AI_HOURLY_COST_LIMIT_USD=0.50

# --- AI Media Enhancement (Muro: audios/videos adicionales) ---
AUPHONIC_API_KEY=
REPLICATE_API_TOKEN=

# --- DIAN (Billing — Colombia) ---
DIAN_ENVIRONMENT=test   # "test" | "production"
DIAN_RESOLUTION_NUMBER=18760000001
DIAN_RESOLUTION_DATE=2026-01-01
DIAN_RESOLUTION_RANGE_FROM=1
DIAN_RESOLUTION_RANGE_TO=999999
DIAN_SOFTWARE_ID=
# Certificate path for DIAN digital signature (XAdES-EPES).
# Leave empty to run in simulation mode.
DIAN_CERTIFICATE_PATH=
DIAN_TECHNICAL_KEY=

# --- Company Info ---
COMPANY_NAME=DonApp
COMPANY_NIT=900000000-0
COMPANY_ADDRESS=Calle 123 #45-67
COMPANY_CITY=Bogotá
COMPANY_PHONE=3000000000
COMPANY_EMAIL=info@donapp.com
COMPANY_DEPARTMENT=Cundinamarca
