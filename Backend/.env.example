# ============================================
# DonApp Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.

# --- Database ---
POSTGRES_USER=servinow_user
POSTGRES_PASSWORD=servinow_secret_password
POSTGRES_DB=servinow_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://servinow_user:servinow_secret_password@db:5432/servinow_db

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Security ---
SECRET_KEY=change-me-to-a-very-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Sensitive Field Encryption (Fernet) ---
# Genera una llave con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Social OAuth (Meta / Facebook / Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v21.0

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Application ---
APP_NAME=DonApp API
APP_VERSION=0.1.0
DEBUG=True

# --- Email / SMTP ---
# SMTP_HOST=smtp.tuservicio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=notificaciones@donapp.com
# SMTP_FROM_NAME=DonApp
# SMTP_USE_TLS=true

# --- Company Info ---
# COMPANY_NAME=
# COMPANY_NIT=
# COMPANY_ADDRESS=
# COMPANY_CITY=
# COMPANY_PHONE=
